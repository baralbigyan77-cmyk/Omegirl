<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Omegirl - AI Companion App</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;user-select:none}
body{background-color:#050505;color:#fff;display:flex;justify-content:center;align-items:center;min-height:100vh;overflow:hidden}
#app-container{width:100%;max-width:414px;height:100vh;max-height:896px;background-color:#0a0a0a;position:relative;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 0 40px rgba(168,85,247,.15);border:1px solid #1a1a1a}
.screen{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;background:#0a0a0a;z-index:10;opacity:0;pointer-events:none;transition:opacity .4s ease-in-out}
.screen.active{opacity:1;pointer-events:auto;z-index:20}
#splash-screen{z-index:100;justify-content:center;align-items:center;background:radial-gradient(circle at center,#1a0b2e 0%,#0a0a0a 100%)}
.logo-container{display:flex;flex-direction:column;align-items:center;animation:pulseLogo 2s infinite alternate ease-in-out}
.heart-logo{width:80px;height:80px;background:linear-gradient(135deg,#a855f7,#ec4899);border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:flex;justify-content:center;align-items:center;box-shadow:0 0 30px rgba(236,72,153,.5);margin-bottom:25px}
.heart-logo::after{content:"••";color:#fff;font-size:24px;transform:rotate(45deg);letter-spacing:2px;font-weight:bold}
.brand-title{font-size:28px;font-weight:800;letter-spacing:2px;background:linear-gradient(to right,#a855f7,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
@keyframes pulseLogo{0%{transform:scale(.98)}100%{transform:scale(1.05)}}
.onboarding-header{padding:30px 20px 10px;text-align:center}
.step-indicator{font-size:12px;color:#a855f7;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;font-weight:600}
.onboarding-title{font-size:22px;font-weight:700;margin-bottom:8px}
.onboarding-sub{font-size:13px;color:#888}
.options-list{padding:20px;display:flex;flex-direction:column;gap:12px;flex:1}
.option-card{background:#141418;border:1px solid #222;padding:16px;border-radius:12px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;transition:all .3s ease}
.option-card:active{transform:scale(.98)}
.option-card.selected{border-color:#a855f7;background:#1e1429}
.option-text strong{display:block;font-size:15px;margin-bottom:2px;color:#fff}
.option-text span{font-size:12px;color:#777}
.radio-circle{width:20px;height:20px;border-radius:50%;border:2px solid #444}
.option-card.selected .radio-circle{border-color:#a855f7;background:#a855f7}
.primary-btn{margin:20px;padding:16px;border-radius:25px;border:none;background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff;font-weight:700;font-size:15px;cursor:pointer;box-shadow:0 4px 15px rgba(168,85,247,.3)}
.auth-container{padding:30px 20px;display:flex;flex-direction:column;height:100%;justify-content:center}
.input-group{margin-bottom:15px}
.input-group label{display:block;font-size:12px;color:#aaa;margin-bottom:6px}
.input-group input{width:100%;padding:14px;background:#141418;border:1px solid #222;border-radius:10px;color:#fff;outline:none}
.app-header{padding:15px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #141418;background:#0a0a0a}
.header-title{font-size:18px;font-weight:800;letter-spacing:1px;color:#fff}
.header-right{display:flex;align-items:center;gap:10px}
.points-badge{background:rgba(168,85,247,.15);border:1px solid #a855f7;color:#a855f7;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:700}
.vip-btn{background:linear-gradient(135deg,#f59e0b,#ec4899);border:none;color:#fff;padding:5px 12px;border-radius:12px;font-size:11px;font-weight:700;cursor:pointer}
.dashboard-content{flex:1;overflow-y:auto;padding-bottom:20px}
.section-title{font-size:13px;color:#888;font-weight:600;padding:15px 20px 10px;text-transform:uppercase;letter-spacing:.5px}
.companions-scroll{display:flex;overflow-x:auto;padding:0 15px;gap:15px;scrollbar-width:none}
.companions-scroll::-webkit-scrollbar{display:none}
.companion-avatar-item{display:flex;flex-direction:column;align-items:center;width:65px;flex-shrink:0;cursor:pointer}
.avatar-ring{width:58px;height:58px;border-radius:50%;padding:2px;background:linear-gradient(135deg,#a855f7,#ec4899);position:relative}
.avatar-ring img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:2px solid #0a0a0a}
.online-dot{width:10px;height:10px;background:#10b981;border-radius:50%;border:2px solid #0a0a0a;position:absolute;bottom:2px;right:2px}
.companion-name{font-size:11px;margin-top:6px;color:#ccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;width:100%;text-align:center}
.chat-list{display:flex;flex-direction:column;padding:0 10px}
.chat-item{display:flex;align-items:center;padding:12px 10px;border-radius:10px;cursor:pointer;transition:background .2s}
.chat-item:active{background:#141418}
.chat-item-avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;margin-right:12px}
.chat-item-details{flex:1;overflow:hidden}
.chat-item-header{display:flex;justify-content:space-between;margin-bottom:4px}
.chat-item-name{font-size:14px;font-weight:600}
.chat-item-time{font-size:10px;color:#666}
.chat-item-preview{font-size:12px;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-header{padding:12px 15px;display:flex;align-items:center;background:#0a0a0a;border-bottom:1px solid #141418}
.back-btn{background:none;border:none;color:#fff;font-size:24px;cursor:pointer;margin-right:10px;line-height:1}
.chat-header-user{flex:1;display:flex;align-items:center;cursor:pointer}
.chat-header-avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;margin-right:10px}
.chat-header-title{font-size:14px;font-weight:600}
.chat-header-sub{font-size:10px;color:#10b981}
.call-icons{display:flex;gap:15px}
.call-icon{background:none;border:none;color:#a855f7;font-size:18px;cursor:pointer}
.profile-accordion{background:#121216;border-bottom:1px solid #222;max-height:0;overflow:hidden;transition:max-height .3s ease-out;padding:0 15px}
.profile-accordion.open{max-height:180px;padding:15px}
.accordion-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12px}
.accordion-item strong{color:#a855f7;display:block;margin-bottom:2px}
.chat-messages{flex:1;padding:15px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;background:#050505}
.msg{max-width:75%;padding:10px 14px;border-radius:16px;font-size:13px;line-height:1.4;animation:fadeIn .3s ease}
.msg.received{background:#18181b;color:#eee;align-self:flex-start;border-bottom-left-radius:4px}
.msg.sent{background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
.typing-indicator{align-self:flex-start;font-size:11px;color:#777;font-style:italic;display:none;padding:5px 10px}
.chat-input-bar{padding:10px 15px;background:#0a0a0a;border-top:1px solid #141418;display:flex;align-items:center;gap:10px}
.chat-input-bar input{flex:1;padding:12px 15px;background:#141418;border:1px solid #222;border-radius:20px;color:#fff;outline:none;font-size:13px}
.chat-input-bar input:disabled{opacity:.5}
.send-btn{background:#a855f7;border:none;color:#fff;width:36px;height:36px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-weight:bold;flex-shrink:0}
.send-btn:disabled{opacity:.4;cursor:not-allowed}
.call-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);z-index:200;display:none;flex-direction:column;justify-content:space-between;align-items:center;padding:60px 20px}
.call-overlay.active{display:flex}
.call-user-info{text-align:center;z-index:2}
.call-avatar{width:110px;height:110px;border-radius:50%;object-fit:cover;border:3px solid #a855f7;margin-bottom:15px;animation:pulseLogo 1.5s infinite alternate}
.call-controls{display:flex;gap:30px;z-index:2;margin-bottom:30px}
.call-secondary-btn{width:56px;height:56px;border-radius:50%;background:#222;border:none;color:#fff;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.call-secondary-btn.muted{background:#a855f7}
.end-call-btn{width:60px;height:60px;border-radius:50%;background:#ef4444;border:none;color:#fff;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.low-points-banner{background:rgba(239,68,68,.12);border:1px solid #ef4444;color:#f87171;font-size:11px;padding:8px 12px;text-align:center;display:none}
.low-points-banner.show{display:block}
.toast{position:absolute;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:#1e1e22;border:1px solid #333;color:#fff;padding:10px 18px;border-radius:20px;font-size:12px;opacity:0;transition:all .3s ease;z-index:300;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.vip-modal-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.7);z-index:250;display:none;justify-content:center;align-items:center;padding:20px}
.vip-modal-overlay.active{display:flex}
.vip-modal{background:#121216;border:1px solid #2a2a2e;border-radius:16px;padding:24px;width:100%;max-width:320px}
.vip-modal h3{font-size:18px;margin-bottom:6px}
.vip-modal p{font-size:12px;color:#888;margin-bottom:18px}
.vip-plan{border:1px solid #222;border-radius:10px;padding:12px 14px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;cursor:pointer}
.vip-plan.selected{border-color:#f59e0b;background:#1a1408}
.vip-plan strong{font-size:13px}
.vip-plan span{font-size:11px;color:#888}
.vip-plan .price{color:#f59e0b;font-weight:700;font-size:13px}
.modal-close-btn{background:none;border:1px solid #333;color:#aaa;padding:12px;border-radius:20px;width:100%;margin-top:6px;cursor:pointer;font-size:13px}
@keyframes fadeIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
</style>
</head>
<body>

<div id="app-container">

  <div id="splash-screen" class="screen active" onclick="switchScreen('onboarding-screen'); renderOnboardingStep();">
    <div class="logo-container">
      <div class="heart-logo"></div>
      <div class="brand-title">OMEGIRL</div>
      <p style="color:#666;font-size:12px;margin-top:8px">Connecting companions...</p>
    </div>
  </div>

  <div id="onboarding-screen" class="screen">
    <div class="onboarding-header">
      <div class="step-indicator" id="step-tag">Step 1 of 2</div>
      <div class="onboarding-title" id="step-title">Are you male or female?</div>
      <div class="onboarding-sub">Customizes your companion recommendations.</div>
    </div>
    <div class="options-list" id="options-container"></div>
    <button class="primary-btn" id="onboarding-next-btn" onclick="nextOnboardingStep()">Continue</button>
  </div>

  <div id="auth-screen" class="screen">
    <div class="auth-container">
      <div class="logo-container" style="margin-bottom:30px">
        <div class="heart-logo" style="width:60px;height:60px"></div>
        <div class="brand-title" style="font-size:22px">Create Account</div>
      </div>
      <div class="input-group">
        <label>Email Address</label>
        <input type="email" id="auth-email" placeholder="name@example.com">
      </div>
      <div class="input-group">
        <label>Password</label>
        <input type="password" id="auth-password" placeholder="At least 6 characters">
      </div>
      <button class="primary-btn" style="margin:20px 0 0 0" onclick="completeAuth()">Continue to App</button>
    </div>
  </div>

  <div id="dashboard-screen" class="screen">
    <div class="app-header">
      <div class="header-title">OMEGIRL</div>
      <div class="header-right">
        <div class="points-badge" id="points-display">100 Points</div>
        <button class="vip-btn" onclick="openVipModal()">VIP</button>
      </div>
    </div>
    <div class="low-points-banner" id="low-points-banner">Running low on points — tap VIP to top up.</div>
    <div class="dashboard-content">
      <div class="section-title">Your Companions</div>
      <div class="companions-scroll" id="companions-bar"></div>
      <div class="section-title">Recent Chats</div>
      <div class="chat-list" id="chats-vertical-list"></div>
    </div>
  </div>

  <div id="chat-screen" class="screen">
    <div class="chat-header">
      <button class="back-btn" onclick="closeChat()">‹</button>
      <div class="chat-header-user" onclick="toggleAccordion()">
        <img id="chat-avatar" class="chat-header-avatar" src="" alt="AI">
        <div>
          <div class="chat-header-title" id="chat-name">Companion</div>
          <div class="chat-header-sub">Online <span style="font-size:10px;color:#888">▼ details</span></div>
        </div>
      </div>
      <div class="call-icons">
        <button class="call-icon" onclick="startCall('audio')">📞</button>
        <button class="call-icon" onclick="startCall('video')">📹</button>
      </div>
    </div>

    <div class="profile-accordion" id="profile-accordion">
      <div class="accordion-grid">
        <div class="accordion-item"><strong>Nationality:</strong> <span id="acc-nat">Japanese</span></div>
        <div class="accordion-item"><strong>Vibe:</strong> <span id="acc-vibe">Artistic</span></div>
        <div class="accordion-item"><strong>Location:</strong> <span id="acc-loc">Tokyo</span></div>
        <div class="accordion-item"><strong>Points Cost:</strong> <span id="acc-cost">10/msg</span></div>
      </div>
    </div>

    <div class="chat-messages" id="chat-messages"></div>
    <div class="typing-indicator" id="typing-indicator">Companion is typing...</div>

    <div class="chat-input-bar">
      <input type="text" id="chat-input" placeholder="Type a message..." onkeydown="if(event.key==='Enter') sendMessage()">
      <button class="send-btn" id="send-btn" onclick="sendMessage()">➤</button>
    </div>
  </div>

  <div class="call-overlay" id="call-overlay">
    <div class="call-user-info">
      <img id="call-avatar" class="call-avatar" src="" alt="Avatar">
      <h2 id="call-name" style="font-size: 20px; font-weight:700;">Name</h2>
      <p id="call-status" style="color:#aaa; font-size:13px; margin-top:5px;">Calling...</p>
    </div>
    <div class="call-controls">
      <button class="call-secondary-btn" id="mute-btn" onclick="toggleMute()">🎙️</button>
      <button class="end-call-btn" onclick="endCall()">✕</button>
      <button class="call-secondary-btn" id="speaker-btn" onclick="toggleSpeaker()">🔊</button>
    </div>
  </div>

  <div class="vip-modal-overlay" id="vip-modal-overlay">
    <div class="vip-modal">
      <h3>Go VIP</h3>
      <p>Top up your points and unlock unlimited chats with every companion.</p>
      <div class="vip-plan selected" data-points="500" data-price="$4.99" onclick="selectVipPlan(this)">
        <div><strong>500 Points</strong><br><span>Starter pack</span></div>
        <div class="price">$4.99</div>
      </div>
      <div class="vip-plan" data-points="1500" data-price="$9.99" onclick="selectVipPlan(this)">
        <div><strong>1,500 Points</strong><br><span>Most popular</span></div>
        <div class="price">$9.99</div>
      </div>
      <div class="vip-plan" data-points="4000" data-price="$19.99" onclick="selectVipPlan(this)">
        <div><strong>4,000 Points</strong><br><span>Best value</span></div>
        <div class="price">$19.99</div>
      </div>
      <button class="primary-btn" style="margin:14px 0 0 0" onclick="purchaseVipPlan()">Purchase</button>
      <button class="modal-close-btn" onclick="closeVipModal()">Not now</button>
    </div>
  </div>

  <div class="toast" id="toast"></div>

</div>

<script>
// Mock Companion Data
const companions = [
  {
    id: '1',
    name: 'Yuki',
    nationality: 'Japanese',
    vibe: 'Artistic & Gentle',
    location: 'Tokyo',
    cost: '10 pts',
    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80',
    greeting: 'Konichiwa! I was just drawing in the park. How is your day going?'
  },
  {
    id: '2',
    name: 'Elena',
    nationality: 'Italian',
    vibe: 'Outgoing & Energetic',
    location: 'Rome',
    cost: '10 pts',
    avatar: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=300&q=80',
    greeting: 'Ciao! I just finished a fresh espresso. What are we getting up to today?'
  },
  {
    id: '3',
    name: 'Mia',
    nationality: 'American',
    vibe: 'Techie & Gamer',
    location: 'San Francisco',
    cost: '10 pts',
    avatar: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=300&q=80',
    greeting: 'Hey! Ready to play some games or just chill and chat?',
    responses: [
      "Okay that's actually a really solid take.",
      "Wait, tell me more, I'm invested now.",
      "Ha, classic. What's the plan after that?",
      "I'm taking notes, this is good stuff."
    ]
  }
];

// App State
let userPoints = 100;
let activeCompanion = null;
let currentStep = 1;
let onboardingData = {};
let callTimerInterval = null;
let callSeconds = 0;
let isMuted = false;
let isSpeakerOn = true;
let selectedVipPoints = 500;
let selectedVipPrice = '$4.99';
let conversationHistories = {}; // companionId -> [{role, content}]

const MESSAGE_COST = 10;
const LOW_POINTS_THRESHOLD = 30;

// Initialize App
function initApp() {
  setTimeout(() => {
    switchScreen('onboarding-screen');
    renderOnboardingStep();
  }, 2000);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initApp);
} else {
  // DOM is already ready (can happen in sandboxed/iframe previews) — init immediately
  initApp();
}

function switchScreen(screenId) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(screenId).classList.add('active');
}

// Onboarding Logic
const onboardingSteps = [
  {
    tag: 'Step 1 of 2',
    title: 'Are you male or female?',
    options: [
      { label: 'Male', sub: 'Looking for female companions' },
      { label: 'Female', sub: 'Looking for male/female companions' },
      { label: 'Non-Binary', sub: 'Open to everyone' }
    ]
  },
  {
    tag: 'Step 2 of 2',
    title: 'What vibe do you prefer?',
    options: [
      { label: 'Artistic & Chill', sub: 'Relaxed conversations & deep talks' },
      { label: 'Energetic & Fun', sub: 'High energy, joking around' },
      { label: 'Intellectual & Tech', sub: 'Deep topics, gaming & tech' }
    ]
  }
];

function renderOnboardingStep() {
  const step = onboardingSteps[currentStep - 1];
  document.getElementById('step-tag').innerText = step.tag;
  document.getElementById('step-title').innerText = step.title;

  const container = document.getElementById('options-container');
  container.innerHTML = '';

  step.options.forEach((opt, idx) => {
    const card = document.createElement('div');
    card.className = 'option-card' + (idx === 0 ? ' selected' : '');
    card.onclick = () => {
      document.querySelectorAll('.option-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      onboardingData[currentStep] = opt.label;
    };
    card.innerHTML = `
      <div class="option-text">
        <strong>${opt.label}</strong>
        <span>${opt.sub}</span>
      </div>
      <div class="radio-circle"></div>
    `;
    container.appendChild(card);
  });

  if (!onboardingData[currentStep]) onboardingData[currentStep] = step.options[0].label;
}

function nextOnboardingStep() {
  if (currentStep < onboardingSteps.length) {
    currentStep++;
    renderOnboardingStep();
  } else {
    switchScreen('auth-screen');
  }
}

function completeAuth() {
  switchScreen('dashboard-screen');
  renderDashboard();
}

// Dashboard Logic
function renderDashboard() {
  updatePointsDisplay();

  const scrollBar = document.getElementById('companions-bar');
  const chatList = document.getElementById('chats-vertical-list');

  scrollBar.innerHTML = '';
  chatList.innerHTML = '';

  companions.forEach(c => {
    // Top Horizontal Avatars
    const avatarItem = document.createElement('div');
    avatarItem.className = 'companion-avatar-item';
    avatarItem.onclick = () => openChat(c);
    avatarItem.innerHTML = `
      <div class="avatar-ring">
        <img src="${c.avatar}" alt="${c.name}">
        <div class="online-dot"></div>
      </div>
      <div class="companion-name">${c.name}</div>
    `;
    scrollBar.appendChild(avatarItem);

    // Recent Chat List Items
    const chatItem = document.createElement('div');
    chatItem.className = 'chat-item';
    chatItem.onclick = () => openChat(c);
    chatItem.innerHTML = `
      <img src="${c.avatar}" class="chat-item-avatar" alt="${c.name}">
      <div class="chat-item-details">
        <div class="chat-item-header">
          <div class="chat-item-name">${c.name}</div>
          <div class="chat-item-time">Just now</div>
        </div>
        <div class="chat-item-preview">${c.greeting}</div>
      </div>
    `;
    chatList.appendChild(chatItem);
  });
}

function updatePointsDisplay() {
  document.getElementById('points-display').innerText = `${userPoints} Points`;
  const banner = document.getElementById('low-points-banner');
  banner.classList.toggle('show', userPoints < LOW_POINTS_THRESHOLD);
}

// Chat Logic
function openChat(companion) {
  activeCompanion = companion;
  document.getElementById('chat-avatar').src = companion.avatar;
  document.getElementById('chat-name').innerText = companion.name;

  document.getElementById('acc-nat').innerText = companion.nationality;
  document.getElementById('acc-vibe').innerText = companion.vibe;
  document.getElementById('acc-loc').innerText = companion.location;
  document.getElementById('acc-cost').innerText = companion.cost;

  const messagesContainer = document.getElementById('chat-messages');
  messagesContainer.innerHTML = '';

  // Add Initial Greeting
  addMessage(companion.greeting, 'received');

  // Reset conversation history for this companion, seeded with the greeting
  if (!conversationHistories[companion.id]) {
    conversationHistories[companion.id] = [
      { role: 'assistant', content: companion.greeting }
    ];
  }

  document.getElementById('chat-input').disabled = false;
  document.getElementById('send-btn').disabled = false;

  switchScreen('chat-screen');
}

function closeChat() {
  switchScreen('dashboard-screen');
  document.getElementById('profile-accordion').classList.remove('open');
}

function toggleAccordion() {
  const accordion = document.getElementById('profile-accordion');
  accordion.classList.toggle('open');
}

function addMessage(text, type) {
  const container = document.getElementById('chat-messages');
  const msg = document.createElement('div');
  msg.className = `msg ${type}`;
  msg.innerText = text;
  container.appendChild(msg);
  container.scrollTop = container.scrollHeight;
}

function sendMessage() {
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if (!text) return;

  if (userPoints < MESSAGE_COST) {
    showToast('Not enough points — top up to keep chatting');
    openVipModal();
    return;
  }

  // Deduct points
  userPoints -= MESSAGE_COST;
  updatePointsDisplay();

  addMessage(text, 'sent');
  input.value = '';

  const companionAtSendTime = activeCompanion;
  conversationHistories[companionAtSendTime.id].push({ role: 'user', content: text });

  // Lock the input while waiting for a real reply
  document.getElementById('chat-input').disabled = true;
  document.getElementById('send-btn').disabled = true;
  showTyping(true);

  generateAIResponse(companionAtSendTime)
    .then(reply => {
      // Only render if the user hasn't navigated to a different chat meanwhile
      if (activeCompanion && activeCompanion.id === companionAtSendTime.id) {
        showTyping(false);
        addMessage(reply, 'received');
        document.getElementById('chat-input').disabled = false;
        document.getElementById('send-btn').disabled = false;
      }
      conversationHistories[companionAtSendTime.id].push({ role: 'assistant', content: reply });
    })
    .catch(err => {
      console.error('AI response error:', err);
      if (activeCompanion && activeCompanion.id === companionAtSendTime.id) {
        showTyping(false);
        addMessage("Sorry, I lost my train of thought for a second — what were you saying?", 'received');
        document.getElementById('chat-input').disabled = false;
        document.getElementById('send-btn').disabled = false;
      }
    });
}

function showTyping(show) {
  const indicator = document.getElementById('typing-indicator');
  indicator.innerText = `${activeCompanion.name} is typing...`;
  indicator.style.display = show ? 'block' : 'none';
}

async function generateAIResponse(companion) {
  const systemPrompt = `You are ${companion.name}, a ${companion.nationality} AI companion living in ${companion.location}. Your personality/vibe: ${companion.vibe}. You are warm, friendly, curious about the user, and easy to talk to — like texting a close friend. Reply directly and specifically to what the user just said; never ignore it or give a generic reply. Keep responses short and conversational, like a real text message (usually 1-3 sentences). Stay fully in character, do not mention that you are an AI or a language model, and do not break the fourth wall. Keep the conversation warm and platonic/friendly in tone — do not produce romantic or sexual content.`;

  const history = conversationHistories[companion.id] || [];
  // Map to the roles the API expects, keeping the last ~20 turns for context
  const apiMessages = history.slice(-20).map(m => ({ role: m.role, content: m.content }));

  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-6",
      max_tokens: 1000,
      system: systemPrompt,
      messages: apiMessages
    })
  });

  if (!response.ok) {
    throw new Error(`API request failed with status ${response.status}`);
  }

  const data = await response.json();
  const textBlock = (data.content || []).find(block => block.type === 'text');
  if (!textBlock || !textBlock.text) {
    throw new Error('No text content in API response');
  }
  return textBlock.text.trim();
}

// Call Logic
function startCall(type) {
  if (!activeCompanion) return;

  if (userPoints < MESSAGE_COST) {
    showToast('Not enough points to start a call');
    openVipModal();
    return;
  }

  const overlay = document.getElementById('call-overlay');
  document.getElementById('call-avatar').src = activeCompanion.avatar;
  document.getElementById('call-name').innerText = activeCompanion.name;
  document.getElementById('call-status').innerText = 'Calling...';

  isMuted = false;
  isSpeakerOn = true;
  document.getElementById('mute-btn').classList.remove('muted');
  document.getElementById('mute-btn').innerText = '🎙️';
  document.getElementById('speaker-btn').innerText = '🔊';

  overlay.classList.add('active');
  callSeconds = 0;

  // Simulate the call connecting after a short ring
  setTimeout(() => {
    if (!overlay.classList.contains('active')) return; // call was ended before it connected
    document.getElementById('call-status').innerText = '00:00';
    callTimerInterval = setInterval(() => {
      callSeconds++;
      const mins = String(Math.floor(callSeconds / 60)).padStart(2, '0');
      const secs = String(callSeconds % 60).padStart(2, '0');
      document.getElementById('call-status').innerText = `${mins}:${secs}`;

      // Deduct a point roughly every 6 seconds to simulate per-minute billing
      if (callSeconds % 6 === 0) {
        if (userPoints <= 0) {
          endCall();
          showToast('Call ended — out of points');
          return;
        }
        userPoints = Math.max(0, userPoints - 1);
        updatePointsDisplay();
      }
    }, 1000);
  }, 1800);
}

function toggleMute() {
  isMuted = !isMuted;
  const btn = document.getElementById('mute-btn');
  btn.classList.toggle('muted', isMuted);
  btn.innerText = isMuted ? '🔇' : '🎙️';
}

function toggleSpeaker() {
  isSpeakerOn = !isSpeakerOn;
  document.getElementById('speaker-btn').innerText = isSpeakerOn ? '🔊' : '🔈';
}

function endCall() {
  clearInterval(callTimerInterval);
  callTimerInterval = null;
  document.getElementById('call-overlay').classList.remove('active');
}

// VIP / Points Modal
function openVipModal() {
  document.getElementById('vip-modal-overlay').classList.add('active');
}

function closeVipModal() {
  document.getElementById('vip-modal-overlay').classList.remove('active');
}

function selectVipPlan(el) {
  document.querySelectorAll('.vip-plan').forEach(p => p.classList.remove('selected'));
  el.classList.add('selected');
  selectedVipPoints = parseInt(el.dataset.points, 10);
  selectedVipPrice = el.dataset.price;
}

function purchaseVipPlan() {
  userPoints += selectedVipPoints;
  updatePointsDisplay();
  closeVipModal();
  showToast(`+${selectedVipPoints} points added`);
}

// Toast
let toastTimeout = null;
function showToast(message) {
  const toast = document.getElementById('toast');
  toast.innerText = message;
  toast.classList.add('show');
  clearTimeout(toastTimeout);
  toastTimeout = setTimeout(() => toast.classList.remove('show'), 2200);
}
</script>
